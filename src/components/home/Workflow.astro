---
import Shot from '../Shot.astro';
import Emblems from '../Emblems.astro';
import pds from '../../assets/screens/full-pds.jpg';
import grading from '../../assets/screens/full-grading.jpg';
import marker from '../../assets/screens/full-marker.jpg';
import nest from '../../assets/screens/full-nest.jpg';
import cutplan from '../../assets/screens/full-cutplan.jpg';
import plot from '../../assets/screens/full-plot.jpg';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Facts and figures: the Rajutara README ("What it does" and "Formats") and the 1.0.0 changelog.
const pdsEmblems = [
  { label: 'rajutara-pds', icon: 'draft' },
  { label: 'DXF', icon: 'import' },
  { label: '.rjx', icon: 'save' },
];
const gradingEmblems = [
  { label: 'rajutara-grading', icon: 'graded-nest' },
  { label: 'RUL', icon: 'measure' },
  { label: 'DXF', icon: 'import' },
];
const markerEmblems = [
  { label: 'rajutara-nest', icon: 'marker-nest' },
  { label: 'HPGL/2', icon: 'marker-plot' },
  { label: 'PDF', icon: 'report' },
  { label: '.rjm', icon: 'save' },
];
const cutplanEmblems = [
  { label: 'rajutara-cutplan', icon: 'solve' },
  { label: 'CSV', icon: 'report' },
  { label: 'PDF', icon: 'report' },
  { label: '.rjc', icon: 'save' },
];
---

<section
  id="workspaces"
  aria-labelledby="workspaces-title"
  class="mx-auto max-w-300 px-5 py-20 lg:py-28"
>
  <h2 id="workspaces-title" class="max-w-[16ch] text-section">
    {t(lang, 'wf.title')}
  </h2>
  <p class="mt-5 max-w-[56ch] text-lg text-muted">{t(lang, 'wf.lede')}</p>

  <div class="mt-16 space-y-24 lg:mt-20 lg:space-y-32">
    <!-- Draft: text left, the wide window right. -->
    <article id="pds" class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="lg:col-span-4">
        <h3 class="text-3xl tracking-tight">{t(lang, 'wf.pdsTitle')}</h3>
        <p class="mt-4 text-muted">{t(lang, 'wf.pdsBody')}</p>
        <Emblems {lang} items={pdsEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={href(lang, '/docs/workspaces/pds/')} class="link">
            {t(lang, 'wf.pdsLink')}
          </a>
        </p>
      </div>
      <div class="land lg:col-span-8">
        <Shot
          src={pds}
          alt={t(lang, 'wf.pdsAlt')}
          sizes="(min-width: 1280px) 780px, (min-width: 1024px) 66vw, 100vw"
          lift
        />
      </div>
    </article>

    <!-- Grade: the same split, mirrored. -->
    <article id="grading" class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="land order-2 lg:order-1 lg:col-span-8">
        <Shot
          src={grading}
          alt={t(lang, 'wf.gradingAlt')}
          sizes="(min-width: 1280px) 780px, (min-width: 1024px) 66vw, 100vw"
          lift
        />
      </div>
      <div class="order-1 lg:order-2 lg:col-span-4">
        <h3 class="text-3xl tracking-tight">{t(lang, 'wf.gradingTitle')}</h3>
        <p class="mt-4 text-muted">{t(lang, 'wf.gradingBody')}</p>
        <Emblems {lang} items={gradingEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={href(lang, '/docs/workspaces/grading/')} class="link">
            {t(lang, 'wf.gradingLink')}
          </a>
        </p>
      </div>
    </article>

    <!-- Nest: text on top, two equal windows below. -->
    <article id="marker">
      <div class="max-w-[60ch]">
        <h3 class="text-3xl tracking-tight">{t(lang, 'wf.markerTitle')}</h3>
        <p class="mt-4 text-muted">{t(lang, 'wf.markerBody')}</p>
        <Emblems {lang} items={markerEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={href(lang, '/docs/workspaces/marker/')} class="link">
            {t(lang, 'wf.markerLink')}
          </a>
        </p>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-8">
        <figure class="land">
          <Shot
            src={marker}
            alt={t(lang, 'wf.markerAlt')}
            sizes="(min-width: 1280px) 584px, (min-width: 768px) 46vw, 100vw"
          />
          <figcaption class="mt-3 text-sm text-muted">{t(lang, 'wf.markerCap')}</figcaption>
        </figure>
        <figure class="land">
          <Shot
            src={nest}
            alt={t(lang, 'wf.nestAlt')}
            sizes="(min-width: 1280px) 584px, (min-width: 768px) 46vw, 100vw"
          />
          <figcaption class="mt-3 text-sm text-muted">{t(lang, 'wf.nestCap')}</figcaption>
        </figure>
      </div>
    </article>

    <!-- Plan: text left, the results window and the plot dialog right. -->
    <article id="cut-plan" class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5 lg:pt-10">
        <h3 class="text-3xl tracking-tight">{t(lang, 'wf.cutTitle')}</h3>
        <p class="mt-4 text-muted">{t(lang, 'wf.cutBody')}</p>
        <Emblems {lang} items={cutplanEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={href(lang, '/docs/workspaces/cut-plan/')} class="link">
            {t(lang, 'wf.cutLink')}
          </a>
        </p>
      </div>
      <div class="space-y-10 lg:col-span-7">
        <figure class="land">
          <Shot
            src={cutplan}
            alt={t(lang, 'wf.cutAlt')}
            sizes="(min-width: 1280px) 680px, (min-width: 1024px) 58vw, 100vw"
            lift
          />
          <figcaption class="mt-3 text-sm text-muted">{t(lang, 'wf.cutCap')}</figcaption>
        </figure>
        <figure id="plot" class="land ml-auto max-w-[80%]">
          <Shot
            src={plot}
            alt={t(lang, 'wf.plotAlt')}
            sizes="(min-width: 1280px) 540px, (min-width: 1024px) 46vw, 80vw"
          />
          <figcaption class="mt-3 text-sm text-muted">{t(lang, 'wf.plotCap')}</figcaption>
        </figure>
      </div>
    </article>
  </div>
</section>
