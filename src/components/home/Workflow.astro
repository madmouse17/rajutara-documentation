---
import Shot from '../Shot.astro';
import Emblems from '../Emblems.astro';
import pds from '../../assets/screens/full-pds.jpg';
import grading from '../../assets/screens/full-grading.jpg';
import marker from '../../assets/screens/full-marker.jpg';
import nest from '../../assets/screens/full-nest.jpg';
import cutplan from '../../assets/screens/full-cutplan.jpg';
import plot from '../../assets/screens/full-plot.jpg';
import { withBase } from '../../lib/site';

// Facts and figures: the Rajutara README ("What it does" and "Formats") and the 1.0.0 changelog.
const pdsEmblems = [
  { label: 'rajutara-pds', icon: 'draft' },
  { label: 'DXF', icon: 'import' },
  { label: '.rjx', icon: 'save' },
];
const gradingEmblems = [
  { label: 'rajutara-grading', icon: 'graded-nest' },
  { label: 'RUL', icon: 'measure' },
  { label: 'DXF', icon: 'import' },
];
const markerEmblems = [
  { label: 'rajutara-nest', icon: 'marker-nest' },
  { label: 'HPGL/2', icon: 'marker-plot' },
  { label: 'PDF', icon: 'report' },
  { label: '.rjm', icon: 'save' },
];
const cutplanEmblems = [
  { label: 'rajutara-cutplan', icon: 'solve' },
  { label: 'CSV', icon: 'report' },
  { label: 'PDF', icon: 'report' },
  { label: '.rjc', icon: 'save' },
];
---

<section
  id="workspaces"
  aria-labelledby="workspaces-title"
  class="mx-auto max-w-300 px-5 py-20 lg:py-28"
>
  <h2 id="workspaces-title" class="max-w-[16ch] text-section">
    One window, four workspaces.
  </h2>
  <p class="mt-5 max-w-[56ch] text-lg text-muted">
    PDS, Grading, Marker and Cut Plan share one open Style and one undo history. Switching tabs
    never means exporting a file.
  </p>

  <div class="mt-16 space-y-24 lg:mt-20 lg:space-y-32">
    <!-- Draft: text left, the wide window right. -->
    <article id="pds" class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="lg:col-span-4">
        <h3 class="text-3xl tracking-tight">Draft the pattern, or import it.</h3>
        <p class="mt-4 text-muted">
          89 tools in a toolbox laid out the way trained operators expect: draft, notch, add seams,
          darts and pleats. Import ASTM DXF from other CAD. Segment lengths, seam allowance and
          grainlines show on the piece.
        </p>
        <Emblems items={pdsEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={withBase('/docs/workspaces/pds/')} class="link">
            PDS guide
          </a>
        </p>
      </div>
      <div class="land lg:col-span-8">
        <Shot
          src={pds}
          alt="The PDS workspace with segment lengths shown on the FRONT piece: neckline, shoulders and armholes with seam allowance and grainline"
          sizes="(min-width: 1280px) 780px, (min-width: 1024px) 66vw, 100vw"
          lift
        />
      </div>
    </article>

    <!-- Grade: the same split, mirrored. -->
    <article id="grading" class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="land order-2 lg:order-1 lg:col-span-8">
        <Shot
          src={grading}
          alt="The Grading workspace: the Grading Table with dX and dY per size next to the graded nest drawn in four size colours"
          sizes="(min-width: 1280px) 780px, (min-width: 1024px) 66vw, 100vw"
          lift
        />
      </div>
      <div class="order-1 lg:order-2 lg:col-span-4">
        <h3 class="text-3xl tracking-tight">Grade by rule, not by redrawing.</h3>
        <p class="mt-4 text-muted">
          Pick a base size and give each grade point a rule: dX and dY per size. The graded nest
          draws every size in its own colour, and it leaves as ASTM DXF with a RUL file.
        </p>
        <Emblems items={gradingEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={withBase('/docs/workspaces/grading/')} class="link">
            Grading guide
          </a>
        </p>
      </div>
    </article>

    <!-- Nest: text on top, two equal windows below. -->
    <article id="marker">
      <div class="max-w-[60ch]">
        <h3 class="text-3xl tracking-tight">Nest the marker by hand or by engine.</h3>
        <p class="mt-4 text-muted">
          Drag pieces from the piece bar, or let the nesting engine fill the fabric: no-fit
          polygons, bottom-left fill and annealing, with live progress. 300 pieces nest in 58 s at
          90.1 %.
        </p>
        <Emblems items={markerEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={withBase('/docs/workspaces/marker/')} class="link">
            Marker guide
          </a>
        </p>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-8">
        <figure class="land">
          <Shot
            src={marker}
            alt="The Marker workspace with the sample tee: 20 pieces of sizes S, M, L and XL placed on 180 cm fabric, the Marker Properties pane on the left"
            sizes="(min-width: 1280px) 584px, (min-width: 768px) 46vw, 100vw"
          />
          <figcaption class="mt-3 text-sm text-muted">
            Placed by hand: 20 pieces of S, M, L and XL on 180 cm fabric, 75.20 %.
          </figcaption>
        </figure>
        <figure class="land">
          <Shot
            src={nest}
            alt="The first 4.5 metres of a 300-piece marker: three rows of nested shirt fronts on 150 cm fabric, no overlaps"
            sizes="(min-width: 1280px) 584px, (min-width: 768px) 46vw, 100vw"
          />
          <figcaption class="mt-3 text-sm text-muted">
            A 300-piece marker saved by the end-to-end test: 0 overlaps, 89.62 %.
          </figcaption>
        </figure>
      </div>
    </article>

    <!-- Plan: text left, the results window and the plot dialog right. -->
    <article id="cut-plan" class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5 lg:pt-10">
        <h3 class="text-3xl tracking-tight">Plan the cut, then plot it.</h3>
        <p class="mt-4 text-muted">
          Turn an order of colours by sizes into markers and lays with plies, fabric length and
          cost. The Cut Order sequences the lays and draws plies from your fabric rolls. Plot to PDF
          or HPGL/2.
        </p>
        <Emblems items={cutplanEmblems} class="mt-5" />
        <p class="mt-6">
          <a href={withBase('/docs/workspaces/cut-plan/')} class="link">
            Cut Plan guide
          </a>
        </p>
      </div>
      <div class="space-y-10 lg:col-span-7">
        <figure class="land">
          <Shot
            src={cutplan}
            alt="Cut Plan results for order PO-100: three markers and nine lays for a three-colour order of 590 garments"
            sizes="(min-width: 1280px) 680px, (min-width: 1024px) 58vw, 100vw"
            lift
          />
          <figcaption class="mt-3 text-sm text-muted">
            Order PO-100 of the end-to-end test: 590 garments in 9 lays.
          </figcaption>
        </figure>
        <figure id="plot" class="land ml-auto max-w-[80%]">
          <Shot
            src={plot}
            alt="The Plot dialog with the Target list open: PDF A4 tiles, PDF A0, HPGL/2 file"
            sizes="(min-width: 1280px) 540px, (min-width: 1024px) 46vw, 80vw"
          />
          <figcaption class="mt-3 text-sm text-muted">
            The Plot dialog: PDF as A4 tiles or one A0 sheet, or an HPGL/2 file.
          </figcaption>
        </figure>
      </div>
    </article>
  </div>
</section>
