---
import { Icon } from 'astro-icon/components';
import { withBase } from '../../lib/site';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// The clip is the real application: scripts/record-demo.sh records it under Xvfb, zooming into the sample
// marker, panning along it and zooming back out. Muted, 10 s, looping, 1280x720.
const media = (file: string) => withBase(`/media/${file}`);

// Five words, each an anchor to the section that tells that part of the story.
const steps = [
  { label: t(lang, 'step.import'), href: '#formats', icon: 'import' },
  { label: t(lang, 'step.draft'), href: '#pds', icon: 'draft' },
  { label: t(lang, 'step.grade'), href: '#grading', icon: 'graded-nest' },
  { label: t(lang, 'step.nest'), href: '#marker', icon: 'marker-nest' },
  { label: t(lang, 'step.plot'), href: '#plot', icon: 'marker-plot' },
];
---

<section aria-labelledby="hero-title" class="mx-auto max-w-300 px-5 pt-10 pb-6 lg:pt-14">
  <h1
    id="hero-title"
    class="rise max-w-[16ch] text-hero font-semibold sm:max-w-[18ch] lg:max-w-none"
    style="--i: 0"
  >
    {t(lang, 'hero.title')}
  </h1>

  <div class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-5 lg:mt-8">
    <p class="rise max-w-[42ch] text-lg text-muted lg:text-xl" style="--i: 1">
      {t(lang, 'hero.lede')}
    </p>
    <div class="rise flex flex-wrap gap-3" style="--i: 2">
      <a href="#download" class="btn btn-primary">
        <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
        {t(lang, 'download')}
      </a>
      <a href={href(lang, '/docs/')} class="btn btn-secondary">
        {t(lang, 'hero.docs')}
      </a>
    </div>
  </div>

  <figure class="hero-media rise mt-10 lg:mt-12" style="--i: 3">
    <video
      data-hero-video
      width="1280"
      height="720"
      poster={media('rajutara-marker-demo-poster.jpg')}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={t(lang, 'hero.video')}
    >
      <source src={media('rajutara-marker-demo.webm')} type="video/webm" />
      <source src={media('rajutara-marker-demo.mp4')} type="video/mp4" />
    </video>
    <button
      type="button"
      class="hero-toggle"
      data-hero-toggle
      data-label-play={t(lang, 'hero.play')}
      data-label-pause={t(lang, 'hero.pause')}
      hidden
      aria-label={t(lang, 'hero.play')}
    >
      <Icon name="ph:pause-fill" class="icon-pause size-5" aria-hidden="true" />
      <Icon name="ph:play-fill" class="icon-play size-5" aria-hidden="true" />
    </button>
  </figure>

  <nav aria-label={t(lang, 'hero.steps')} class="mt-10 lg:mt-12">
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <a href={s.href}>
            <span class="mark">
              <Icon name={s.icon} class="size-6" aria-hidden="true" />
            </span>
            <span class="word">{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>

<style>
  .hero-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
    box-shadow: var(--shadow-lift);
  }
  .hero-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Moving content that runs longer than five seconds needs a way to stop it (WCAG 2.2.2). */
  .hero-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--outline);
  }
  .hero-toggle:hover {
    border-color: var(--fg);
  }
  .hero-toggle[data-state='playing'] .icon-play,
  .hero-toggle:not([data-state='playing']) .icon-pause {
    display: none;
  }

  /* The workflow strip: five steps joined by a hairline, like stations along one line. */
  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .steps li {
    position: relative;
  }
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.75rem;
    left: calc(50% + 1.75rem);
    right: calc(-50% + 1.75rem);
    height: 1px;
    background: var(--outline);
    pointer-events: none;
  }
  .steps a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.25rem 0.5rem;
    color: var(--fg);
  }
  .mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--accent-text);
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .steps a:hover .mark {
    border-color: var(--accent-text);
    background: var(--surface-2);
  }
  .word {
    font-weight: 500;
    font-size: 1rem;
  }
  @media (max-width: 30rem) {
    .mark {
      width: 3rem;
      height: 3rem;
    }
    .steps li:not(:last-child)::after {
      top: 1.5rem;
      left: calc(50% + 1.5rem);
      right: calc(-50% + 1.5rem);
    }
    .word {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // The clip plays while it is on screen and the visitor has not asked for less motion or paused it.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');

  if (video && toggle) {
    let pausedByVisitor = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (playing: boolean) => {
      toggle.dataset.state = playing ? 'playing' : 'paused';
      toggle.setAttribute(
        'aria-label',
        (playing ? toggle.dataset.labelPause : toggle.dataset.labelPlay) ?? '',
      );
    };
    video.addEventListener('play', () => show(true));
    video.addEventListener('pause', () => show(false));

    toggle.hidden = false;
    show(false);
    toggle.addEventListener('click', () => {
      pausedByVisitor = !video.paused;
      if (video.paused) void video.play();
      else video.pause();
    });

    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) video.pause();
        else if (!pausedByVisitor) void video.play().catch(() => {});
      },
      { threshold: 0.25 },
    ).observe(video);
  }
</script>
