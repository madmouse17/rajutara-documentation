---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import teeMarker from '../../assets/gallery/tee-marker.png';
import { REPO } from '../../lib/site';
import { formatBytes, listSamples } from '../../lib/samples';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// The files are read from public/samples at build time, so the buttons always match what is on offer.
const samples = listSamples(lang);
const pick = (type: string) => samples.find((f) => f.type === type);
const files = [
  { label: t(lang, 'start.fileStyle'), file: pick('style') },
  { label: t(lang, 'start.fileMarker'), file: pick('marker') },
  { label: t(lang, 'start.fileDxf'), file: pick('dxf') },
].flatMap((f) => (f.file ? [{ label: f.label, file: f.file }] : []));
---

<section id="start" aria-labelledby="start-title" class="mx-auto max-w-300 px-5 pb-20 lg:pb-28">
  <h2 id="start-title" class="max-w-[14ch] text-section">
    {t(lang, 'start.title')}
  </h2>
  <p class="mt-5 max-w-[56ch] text-lg text-muted">{t(lang, 'start.lede')}</p>

  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-12">
    <article class="flex flex-col rounded-ui border border-line bg-surface p-6 md:col-span-2 lg:col-span-6">
      <div class="overflow-hidden rounded-lg border border-line bg-white">
        <Image
          src={teeMarker}
          alt={t(lang, 'start.alt')}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 520px, (min-width: 768px) 90vw, 100vw"
          class="block h-auto w-full"
          loading="lazy"
        />
      </div>
      <h3 class="mt-6 text-2xl tracking-tight">{t(lang, 'start.teeTitle')}</h3>
      <p class="mt-2 text-muted">{t(lang, 'start.teeBody')}</p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {files.map((f) => (
          <li>
            <a href={f.file.url} class="btn btn-secondary" download>
              <Icon name="ph:file-arrow-down" class="size-5" aria-hidden="true" />
              {f.label}
              <span class="text-sm font-normal text-muted">{formatBytes(f.file.bytes)}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm">
        <a href={href(lang, '/gallery/')} class="link">
          {t(lang, 'start.allFiles')}
        </a>
      </p>
    </article>

    <article class="flex flex-col rounded-ui border border-line bg-surface p-6 md:col-span-2 lg:col-span-6">
      <Icon name="draft" class="size-7 text-accent-text" aria-hidden="true" />
      <h3 class="mt-4 text-lg font-semibold tracking-tight">{t(lang, 'start.ex1Title')}</h3>
      <p class="mt-2 text-sm text-muted">{t(lang, 'start.ex1Body')}</p>
      <p class="mt-4 text-sm">
        <a href={`${REPO}/tree/main/crates/rajutara/examples`} class="link" rel="noopener">
          {t(lang, 'start.viewExample')}
        </a>
      </p>
    </article>
  </div>
</section>
