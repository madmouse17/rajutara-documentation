---
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// The command and the line it prints are the ones in the Rajutara README ("Built for agents"); the same
// line is what CI reads for its budgets. Values vary by machine, the keys do not.
const command =
  'LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 1280x800x24" target/release/rajutara --smoke';
const smoke =
  '{"frames":60,"first_frame_ms":56.5,"max_frame_cpu_ms":0.328,"warmup_ms":0.000,"peak_rss_kb":122392,"gl_renderer":"llvmpipe (LLVM 21.1.8, 256 bits)","gl_version":"4.5 (Core Profile) Mesa 26.0.8-1ubuntu0.3"}';
const headless = 'cargo run --release -p rajutara --example tshirt_sample -- out/';

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Strings are matched whole, so a number inside "21.1.8" is never coloured on its own.
const smokeHtml = escape(smoke).replace(
  /("(?:[^"\\]|\\.)*")(\s*:)?|(-?\d+(?:\.\d+)?)/g,
  (_m, str, colon, num) =>
    str
      ? colon
        ? `<span class="tok-key">${str}</span>${colon}`
        : `<span class="tok-str">${str}</span>`
      : `<span class="tok-num">${num}</span>`,
);
---

<section id="agents" aria-labelledby="agents-title" class="mx-auto max-w-300 px-5 pb-20 lg:pb-28">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <h2 id="agents-title" class="max-w-[16ch] text-section">
        {t(lang, 'agents.title')}
      </h2>
      <p class="mt-5 text-lg text-muted">{t(lang, 'agents.lede')}</p>
      <ul class="mt-6 space-y-3 text-muted">
        <li>{t(lang, 'agents.b1')}</li>
        <li>{t(lang, 'agents.b2')}</li>
        <li>{t(lang, 'agents.b3')}</li>
      </ul>
      <p class="mt-6">
        <a href={href(lang, '/docs/headless/')} class="link">
          {t(lang, 'agents.link')}
        </a>
      </p>
    </div>

    <div class="space-y-10 lg:col-span-7">
      <figure>
        <figcaption class="mb-3 text-muted">{t(lang, 'agents.cap1')}</figcaption>
        <pre
          class="code"
          tabindex="0"
          aria-label={t(lang, 'agents.command')}
        ><code>{command}</code></pre>
        <pre
          class="code mt-2"
          tabindex="0"
          aria-label={t(lang, 'agents.output')}
        ><code set:html={smokeHtml} /></pre>
      </figure>
      <figure>
        <figcaption class="mb-3 text-muted">{t(lang, 'agents.cap2')}</figcaption>
        <pre
          class="code"
          tabindex="0"
          aria-label={t(lang, 'agents.command')}
        ><code>{headless}</code></pre>
      </figure>
    </div>
  </div>
</section>

<style>
  .code {
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    /* Long lines wrap instead of scrolling: the JSON line is the whole point of the block. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .code :global(.tok-key) {
    color: var(--fg-muted);
  }
  .code :global(.tok-str) {
    color: var(--fg);
  }
  .code :global(.tok-num) {
    color: var(--accent-text);
  }
</style>
