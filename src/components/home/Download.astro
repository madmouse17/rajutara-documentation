---
import { Icon } from 'astro-icon/components';
import { RELEASE, RELEASES_URL, assetUrl, withBase } from '../../lib/site';

// File names follow the Downloads table of the Rajutara README. Version and tag live in src/lib/site.ts.
const v = RELEASE.version;
const groups = [
  {
    name: 'Linux',
    icon: 'ph:linux-logo',
    detail: 'x86_64',
    files: [
      {
        kind: 'AppImage',
        file: `rajutara-${v}-x86_64.AppImage`,
        note: 'Make it executable and run it. Without FUSE 2, start it with APPIMAGE_EXTRACT_AND_RUN=1.',
      },
    ],
  },
  {
    name: 'Windows 64-bit',
    icon: 'ph:windows-logo',
    detail: 'Windows 7 SP1 through Windows 11',
    files: [
      { kind: 'Installer', file: `rajutara-${v}-windows-x64.msi`, note: 'The .msi installer.' },
      {
        kind: 'Portable',
        file: `rajutara-${v}-windows-x64.zip`,
        note: 'Unzip it and run rajutara.exe.',
      },
    ],
  },
  {
    name: 'Windows 32-bit',
    icon: 'ph:windows-logo',
    detail: 'Windows 7 SP1 through Windows 11',
    files: [
      { kind: 'Installer', file: `rajutara-${v}-windows-x86.msi`, note: 'The .msi installer.' },
      {
        kind: 'Portable',
        file: `rajutara-${v}-windows-x86.zip`,
        note: 'Unzip it and run rajutara.exe.',
      },
    ],
  },
];

// Source: the Status section of the Rajutara README.
const status = [
  {
    head: 'Windows 7 is untested on hardware.',
    body: 'The Windows builds run under Wine and pass an import-table check. The run on a real Windows 7 PC is still pending.',
  },
  { head: '3D is interface-only.', body: 'There is no 3D window.' },
  {
    head: 'No cutter drivers.',
    body: 'Markers write PDF and HPGL/2, including one generic HPGL/2 cut file, and nothing vendor-specific.',
  },
  {
    head: 'The Indonesian strings are unconfirmed.',
    body: 'Every English string has an Indonesian one, but no Indonesian-speaking Operator has reviewed the wording.',
  },
  {
    head: 'Phase 3 is not started.',
    body: 'Stripe and plaid matching, tilt, block fuse, flaws and cross grading are on the roadmap.',
  },
];
---

<section id="download" aria-labelledby="download-title" class="mx-auto max-w-300 px-5">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <h2 id="download-title" class="text-section">Download Rajutara {v}.</h2>
      <p class="mt-5 max-w-[52ch] text-lg text-muted">
        Free software under MIT or Apache-2.0. Every package ships the licences and the list of
        third-party software.
      </p>

      <div class="mt-10">
        {
          groups.map((g) => (
            <div class="grid gap-4 border-t border-line py-6 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <div>
                <h3 class="flex items-center gap-2 text-lg tracking-tight">
                  <Icon name={g.icon} class="size-5 text-muted" aria-hidden="true" />
                  {g.name}
                </h3>
                <p class="mt-1 text-sm text-muted">{g.detail}</p>
              </div>
              <ul class="space-y-4">
                {g.files.map((f) => (
                  <li class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <a href={assetUrl(f.file)} class="btn btn-secondary">
                      <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
                      {f.kind}
                    </a>
                    <div class="min-w-0">
                      <p class="font-mono text-sm break-all">{f.file}</p>
                      <p class="text-sm text-muted">{f.note}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="border-t border-line pt-6 text-muted">
        No OpenGL driver on the Windows PC? The packages carry a software renderer for that case,
        explained in the <a href={withBase('/docs/windows-7/')} class="link">Windows 7 notes</a>.
        All files and checksums are on the <a href={RELEASES_URL} class="link">releases page</a>.
        To build from source, start with <a href={withBase('/docs/getting-started/')} class="link"
          >getting started</a
        >.
      </p>
    </div>

    <div class="lg:col-span-5 lg:pt-2">
      <h3 class="text-2xl tracking-tight">Before you rely on it</h3>
      <p class="mt-3 text-muted">Rajutara {v} is the first release. Know these five things.</p>
      <ul class="mt-6 space-y-5">
        {
          status.map((s) => (
            <li>
              <p class="font-medium">{s.head}</p>
              <p class="mt-1 text-muted">{s.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6">
        <a href={withBase('/docs/roadmap/')} class="link">Roadmap from 1.0 to v2</a>
      </p>
    </div>
  </div>
</section>
