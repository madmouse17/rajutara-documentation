---
import { Icon } from 'astro-icon/components';
import { RELEASE, RELEASES_URL, assetUrl } from '../../lib/site';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// File names follow the Downloads table of the Rajutara README. Version and tag live in src/lib/site.ts.
const v = RELEASE.version;
const groups = [
  {
    name: 'Linux',
    icon: 'ph:linux-logo',
    detail: 'x86_64',
    files: [
      {
        kind: 'AppImage',
        file: `rajutara-${v}-x86_64.AppImage`,
        note: t(lang, 'dl.appimageNote'),
      },
    ],
  },
  {
    name: t(lang, 'dl.win64'),
    icon: 'ph:windows-logo',
    detail: t(lang, 'dl.win'),
    files: [
      {
        kind: t(lang, 'dl.installer'),
        file: `rajutara-${v}-windows-x64.msi`,
        note: t(lang, 'dl.msiNote'),
      },
      {
        kind: t(lang, 'dl.portable'),
        file: `rajutara-${v}-windows-x64.zip`,
        note: t(lang, 'dl.zipNote'),
      },
    ],
  },
  {
    name: t(lang, 'dl.win32'),
    icon: 'ph:windows-logo',
    detail: t(lang, 'dl.win'),
    files: [
      {
        kind: t(lang, 'dl.installer'),
        file: `rajutara-${v}-windows-x86.msi`,
        note: t(lang, 'dl.msiNote'),
      },
      {
        kind: t(lang, 'dl.portable'),
        file: `rajutara-${v}-windows-x86.zip`,
        note: t(lang, 'dl.zipNote'),
      },
    ],
  },
];

// Source: the Status section of the Rajutara README.
const status = (['s1', 's2', 's3', 's4', 's5'] as const).map((k) => ({
  head: t(lang, `dl.${k}h`),
  body: t(lang, `dl.${k}b`),
}));
---

<section id="download" aria-labelledby="download-title" class="mx-auto max-w-300 px-5">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <h2 id="download-title" class="text-section">
        {t(lang, 'dl.title', { v })}
      </h2>
      <p class="mt-5 max-w-[52ch] text-lg text-muted">{t(lang, 'dl.lede')}</p>

      <div class="mt-10">
        {groups.map((g) => (
          <div class="grid gap-4 border-t border-line py-6 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <div>
              <h3 class="flex items-center gap-2 text-lg tracking-tight">
                <Icon name={g.icon} class="size-5 text-muted" aria-hidden="true" />
                {g.name}
              </h3>
              <p class="mt-1 text-sm text-muted">{g.detail}</p>
            </div>
            <ul class="space-y-4">
              {g.files.map((f) => (
                <li class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <a href={assetUrl(f.file)} class="btn btn-secondary">
                    <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
                    {f.kind}
                  </a>
                  <div class="min-w-0">
                    <p class="font-mono text-sm break-all">{f.file}</p>
                    <p class="text-sm text-muted">{f.note}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="border-t border-line pt-6 text-muted">
        {t(lang, 'dl.noGl')}{' '}
        <a href={href(lang, '/docs/windows-7/')} class="link">
          {t(lang, 'dl.win7Link')}
        </a>
        . {t(lang, 'dl.checksums')}{' '}
        <a href={RELEASES_URL} class="link">
          {t(lang, 'dl.releasesLink')}
        </a>
        . {t(lang, 'dl.legacyBefore')}
        <span class="font-mono">.optx</span>, <span class="font-mono">.optm</span>,{' '}
        <span class="font-mono">.optc</span>
        {t(lang, 'dl.legacyMiddle', { v })} <span class="font-mono">.rjx</span>,{' '}
        <span class="font-mono">.rjm</span>, <span class="font-mono">.rjc</span>.{' '}
        {t(lang, 'dl.source')}{' '}
        <a href={href(lang, '/docs/getting-started/')} class="link">
          {t(lang, 'dl.gettingStartedLink')}
        </a>
        .
      </p>
    </div>

    <div class="lg:col-span-5 lg:pt-2">
      <h3 class="text-2xl tracking-tight">{t(lang, 'dl.beforeTitle')}</h3>
      <p class="mt-3 text-muted">{t(lang, 'dl.beforeLede', { v })}</p>
      <ul class="mt-6 space-y-5">
        {status.map((s) => (
          <li>
            <p class="font-medium">{s.head}</p>
            <p class="mt-1 text-muted">{s.body}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a href={href(lang, '/docs/roadmap/')} class="link">
          {t(lang, 'dl.roadmap')}
        </a>
      </p>
    </div>
  </div>
</section>
