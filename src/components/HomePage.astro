---
import Base from '../layouts/Base.astro';
import Hero from './home/Hero.astro';
import Sequence from './home/Sequence.astro';
import Workflow from './home/Workflow.astro';
import StartFaster from './home/StartFaster.astro';
import MadeWith from './home/MadeWith.astro';
import Numbers from './home/Numbers.astro';
import Formats from './home/Formats.astro';
import Agents from './home/Agents.astro';
import Download from './home/Download.astro';
import Closing from './home/Closing.astro';
import { withBase } from '../lib/site';
import { sitePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base
  title={t(lang, 'home.title')}
  description={t(lang, 'home.description')}
  path={sitePath(lang, '/')}
  lang={lang}
>
  <!-- The poster is the largest paint of the page, so it is fetched before anything else asks for it. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={withBase('/media/rajutara-marker-demo-poster.jpg')}
    fetchpriority="high"
  />
  <Hero lang={lang} />
  <Sequence lang={lang} />
  <Workflow lang={lang} />
  <StartFaster lang={lang} />
  <MadeWith lang={lang} />
  <Numbers lang={lang} />
  <Formats lang={lang} />
  <Agents lang={lang} />
  <Download lang={lang} />
  <Closing lang={lang} />
</Base>
