---
// A product screenshot: optimised sizes, a fixed ratio so nothing shifts while it loads, and a link to
// the full-size file because the details (Pieces Table, status bar) are worth reading.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` attribute: how wide the image is drawn at each breakpoint. */
  sizes: string;
  widths?: number[];
  /** Above-the-fold image: load now and at high priority. */
  priority?: boolean;
  lift?: boolean;
  class?: string;
}

const { src, alt, sizes, widths = [640, 960, 1280], priority = false, lift = false } = Astro.props;
---

<a
  href={src.src}
  class:list={[
    'block overflow-hidden rounded-ui border border-line bg-surface',
    { 'shadow-lift': lift },
    Astro.props.class,
  ]}
>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="block h-auto w-full"
  />
</a>
