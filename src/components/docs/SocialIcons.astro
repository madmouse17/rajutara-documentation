---
// Header links beside the GitHub icon: the pages that live outside the docs.
import { Icon } from '@astrojs/starlight/components';
import { REPO } from '../../lib/site';
import { href } from '../../lib/i18n';

const labels = {
  en: { gallery: 'Gallery', download: 'Download', github: 'Rajutara on GitHub' },
  id: { gallery: 'Galeri', download: 'Unduh', github: 'Rajutara di GitHub' },
} as const;
const lang = Astro.locals.starlightRoute.lang === 'id' ? 'id' : 'en';
const t = labels[lang];
---

<a href={href(lang, '/gallery/')}>{t.gallery}</a>
<a href={href(lang, '/#download')}>{t.download}</a>
<a href={REPO} rel="me noopener" class="github">
  <span class="sr-only">{t.github}</span>
  <Icon name="github" />
</a>

<style>
  a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    padding: 0.5em;
    margin: -0.5em;
    white-space: nowrap;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  .github {
    display: inline-flex;
  }
</style>
