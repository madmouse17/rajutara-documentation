---
// The title always links to the landing page, also from the Indonesian pages (there is no /id/ home).
import { Image } from 'astro:assets';
import logo from '../../assets/logo/optirust-128.png';
import { withBase } from '../../lib/site';
---

<a href={withBase('/')} class="site-title">
  <Image src={logo} alt="" width={64} height={64} class="mark" />
  <span translate="no">optirust</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sl-color-white);
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    width: 2rem;
    height: 2rem;
  }
</style>
