---
import { getDocIds, getVersionFromPath, getPathForVersion, VERSIONS } from '../../lib/versions';

const pathname = Astro.url.pathname;
const currentVersion = getVersionFromPath(pathname);
const docIds = await getDocIds();
const lang = Astro.locals.starlightRoute.lang === 'id' ? 'id' : 'en';

const accessibleLabel = lang === 'id' ? 'Versi dokumentasi' : 'Documentation version';

const options = VERSIONS.map((v) => ({
  slug: v.slug,
  label: v.label,
  url: getPathForVersion(pathname, v.slug, docIds),
  selected: v.slug === currentVersion.slug,
}));
---

<div class="version-select-wrapper">
  <label for="rajutara-version-select" class="sr-only">
    {accessibleLabel}
  </label>
  <select
    id="rajutara-version-select"
    class="version-select"
    aria-label={accessibleLabel}
    data-version-select
  >
    {options.map((opt) => (
      <option value={opt.url} selected={opt.selected}>
        {opt.label}
      </option>
    ))}
  </select>
  <svg
    class="caret"
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M4 6L8 10L12 6"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>

<script>
  document.addEventListener('change', (e) => {
    const target = e.target;
    if (target instanceof HTMLSelectElement && target.hasAttribute('data-version-select')) {
      if (target.value && target.value !== window.location.pathname) {
        window.location.href = target.value;
      }
    }
  });

  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    const select = document.querySelector<HTMLSelectElement>('select[data-version-select]');
    if (!select) return;
    const opt = select.querySelector<HTMLOptionElement>('option[selected]');
    if (opt && select.selectedIndex !== opt.index) {
      select.selectedIndex = opt.index;
    }
  });
</script>

<style>
  .version-select-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .version-select {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-size: 0.8125rem;
    font-weight: 550;
    font-family: inherit;
    line-height: 1;
    padding: 0.25rem 1.4rem 0.25rem 0.55rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .version-select:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  .version-select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .caret {
    position: absolute;
    right: 0.4rem;
    width: 0.75rem;
    height: 0.75rem;
    pointer-events: none;
    color: var(--sl-color-gray-3);
  }
</style>
