---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/logo/optirust-128.png';
import ThemeToggle from './ThemeToggle.astro';
import { REPO, withBase } from '../lib/site';

interface Props {
  current?: 'home' | 'gallery';
}

const { current = 'home' } = Astro.props;

const links = [
  { href: withBase('/#workspaces'), label: 'Workspaces', id: 'workspaces' },
  { href: withBase('/#agents'), label: 'Agents', id: 'agents' },
  { href: withBase('/#download'), label: 'Download', id: 'download' },
  { href: withBase('/docs/'), label: 'Docs', id: 'docs' },
  { href: withBase('/gallery/'), label: 'Gallery', id: 'gallery' },
];
---

<header class="sticky top-0 z-20 border-b border-line bg-bg">
  <div class="mx-auto flex h-16 max-w-300 items-center gap-6 px-5">
    <a href={withBase('/')} class="flex items-center gap-2.5" aria-label="optirust, home">
      <Image src={logo} alt="" width={64} height={64} class="size-8" />
      <span class="text-xl font-semibold tracking-tight" translate="no">optirust</span>
    </a>

    <nav class="ml-4 hidden items-center md:flex" aria-label="Site">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="inline-flex h-11 items-center px-3 text-sm font-medium text-muted hover:text-fg aria-[current=page]:text-fg"
            aria-current={link.id === current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center">
      <a
        href={REPO}
        rel="me"
        class="grid size-11 place-items-center rounded-ui text-muted hover:text-fg"
      >
        <span class="sr-only">optirust on GitHub</span>
        <Icon name="ph:github-logo" class="size-6" aria-hidden="true" />
      </a>
      <ThemeToggle />

      <details class="relative md:hidden" data-menu>
        <summary
          class="grid size-11 cursor-pointer list-none place-items-center rounded-ui text-muted hover:text-fg [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="ph:list" class="size-6" aria-hidden="true" />
        </summary>
        <nav
          class="absolute top-12 right-0 w-56 rounded-ui border border-line bg-surface p-2 shadow-lift"
          aria-label="Site, small screens"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="flex h-11 items-center rounded-ui px-3 text-sm font-medium text-muted hover:bg-surface-2 hover:text-fg"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the small-screen menu after a link is chosen (anchors on the same page keep it open otherwise).
  document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.removeAttribute('open');
    });
  });
</script>
