---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/logo/rajutara-128.png';
import ThemeToggle from './ThemeToggle.astro';
import { navFor } from '../lib/nav';
import { href, t, twinPath, type Lang } from '../lib/i18n';
import { withBase } from '../lib/site';

interface Props {
  lang: Lang;
  /** Site path of this page, with its language prefix: the switcher links to its twin. */
  path: string;
}

const { lang, path } = Astro.props;
const nav = navFor(lang);
const twin = twinPath(path);
const switcher = (
  [
    { code: 'en', label: 'English', href: withBase(lang === 'en' ? path : twin.path) },
    { code: 'id', label: 'Bahasa Indonesia', href: withBase(lang === 'id' ? path : twin.path) },
  ] as const
).map((l) => ({ ...l, current: l.code === lang }));
---

<header class="site-header">
  <div class="mx-auto flex h-16 max-w-300 items-center gap-4 px-5">
    <a href={href(lang, '/')} class="brand" aria-label={t(lang, 'brand.home')}>
      <Image src={logo} alt="" width={64} height={64} class="size-8" />
      <span class="text-xl font-semibold tracking-tight" translate="no">
        Rajutara
      </span>
    </a>

    <nav class="ml-4 hidden md:block" aria-label={t(lang, 'nav.site')}>
      <ul class="flex items-center">
        {nav.map((group) => (
          <li>
            <details class="group" name="site-nav">
              <summary class="trigger">
                {group.label}
                <Icon name="ph:caret-down" class="caret size-4" aria-hidden="true" />
              </summary>
              <ul class="drop">
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} rel={item.external ? 'noopener' : undefined}>
                      {item.icon && <Icon name={item.icon} class="size-5" aria-hidden="true" />}
                      {item.label}
                      {item.external && (
                        <Icon name="ph:arrow-up-right" class="ext size-4" aria-hidden="true" />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <nav class="lang" aria-label={t(lang, 'language')}>
        {switcher.map((l) => (
          <a
            href={l.href}
            lang={l.code}
            hreflang={l.code}
            aria-current={l.current ? 'true' : undefined}
            aria-label={`${l.code.toUpperCase()}, ${l.label}`}
            title={l.label}
          >
            {l.code.toUpperCase()}
          </a>
        ))}
      </nav>
      <ThemeToggle />
      <a href={href(lang, '/#download')} class="btn btn-primary ml-2 hidden md:inline-flex">
        {t(lang, 'download')}
      </a>

      <details class="menu md:hidden">
        <summary class="burger" aria-label={t(lang, 'nav.menu')}>
          <Icon name="ph:list" class="size-6" aria-hidden="true" />
        </summary>
        <nav class="panel" aria-label={t(lang, 'nav.siteSmall')}>
          {nav.map((group) => (
            <section>
              <p class="label">{group.label}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href} rel={item.external ? 'noopener' : undefined}>
                      {item.label}
                      {item.external && (
                        <Icon name="ph:arrow-up-right" class="ext size-4" aria-hidden="true" />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <a href={href(lang, '/#download')} class="btn btn-primary mt-3 w-full">
            {t(lang, 'download')}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  /* Language switcher: two short links, the current one marked by weight and an underline, not by colour alone. */
  .lang {
    display: flex;
    align-items: center;
  }
  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .lang a:hover {
    color: var(--fg);
  }
  .lang a[aria-current] {
    color: var(--fg);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .brand {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.625rem;
  }

  /* Dropdown groups: plain <details>, so they open with Enter or Space and need no script to work. */
  .group {
    position: relative;
  }
  .trigger,
  .burger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .trigger::-webkit-details-marker,
  .burger::-webkit-details-marker {
    display: none;
  }
  .trigger:hover,
  .burger:hover,
  .group[open] > .trigger {
    color: var(--fg);
  }
  .group[open] > .trigger {
    background: var(--surface-2);
  }
  .caret {
    transition: rotate 160ms ease;
  }
  .group[open] .caret {
    rotate: 180deg;
  }
  .burger {
    width: 2.75rem;
    justify-content: center;
    padding: 0;
  }

  .drop {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 13.5rem;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }
  .drop a,
  .panel a:not(.btn) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 0.5rem;
    color: var(--fg);
    font-size: 0.9375rem;
  }
  .drop a:hover,
  .panel a:not(.btn):hover {
    background: var(--surface-2);
  }
  .drop a :global(svg:not(.ext)) {
    color: var(--fg-muted);
  }
  .ext {
    margin-left: auto;
    color: var(--fg-faint);
  }

  .menu {
    position: relative;
  }
  .panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(20rem, calc(100vw - 2.5rem));
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }
  .panel .label {
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--fg-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }
</style>

<script>
  // Dropdowns close on Escape (focus returns to the group that was open), on a click or focus outside, and
  // when another group opens. The small-screen menu closes the same ways and after a link is chosen.
  const groups = [...document.querySelectorAll<HTMLDetailsElement>('.site-header details')];

  const closeAll = (except?: Element | null) => {
    for (const group of groups) if (group !== except) group.removeAttribute('open');
  };

  for (const group of groups) {
    group.addEventListener('toggle', () => group.open && closeAll(group));
    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) group.removeAttribute('open');
    });
    group.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeAll()));
  }

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.site-header details')) closeAll();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = groups.find((group) => group.open);
    if (!open) return;
    open.removeAttribute('open');
    open.querySelector('summary')?.focus();
  });
</script>
