---
// Atelier3DBackground.astro
// Elegant, lightweight ambient 3D convection & tailoring atelier background.
// Features sewing threads, needles, thread spools, measuring tape, and tailoring tools.
// Highly optimized WebGL via Three.js with procedural geometries, zero external assets,
// theme adaptation, and automatic lifecycle/visibility pausing.
---

<div class="atelier-3d-container" aria-hidden="true">
  <canvas id="atelier-3d-canvas" class="atelier-3d-canvas"></canvas>
  <div class="atelier-3d-overlay"></div>
</div>

<style>
  .atelier-3d-container {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    user-select: none;
    opacity: 0.88;
    transition: opacity 0.4s ease;
  }

  :root[data-theme='light'] .atelier-3d-container {
    opacity: 0.78;
  }

  .atelier-3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .atelier-3d-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Soft vignette keeping center text 100% legible */
    background: radial-gradient(
      circle at 50% 35%,
      transparent 25%,
      color-mix(in srgb, var(--bg) 65%, transparent) 70%,
      var(--bg) 100%
    );
  }
</style>

<script>
  import * as THREE from 'three';

  function initAtelier3D() {
    const canvas = document.getElementById('atelier-3d-canvas') as HTMLCanvasElement | null;
    const container = canvas?.parentElement;
    if (!canvas || !container) return;

    // Check prefers-reduced-motion
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReducedMotion = reducedMotionQuery.matches;

    // Renderer setup (capped DPR for performance: "tetap ringan")
    let width = window.innerWidth;
    let height = window.innerHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);

    let renderer: THREE.WebGLRenderer | null = null;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'low-power',
      });
    } catch {
      // WebGL unavailable, gracefully exit
      return;
    }

    renderer.setSize(width, height, false);
    renderer.setPixelRatio(dpr);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // Scene & Camera
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 50);
    camera.position.set(0, 0, 9.5);

    // Parallax & state
    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;
    let isVisible = true;
    let isTabActive = true;
    let animId: number | null = null;
    let startTime = performance.now();

    // Theme detection
    const isLightMode = () => document.documentElement.dataset.theme === 'light';

    // Materials dictionary for dynamic theme update
    const materials: {
      steel: THREE.MeshStandardMaterial;
      needle: THREE.MeshStandardMaterial;
      spoolWood: THREE.MeshStandardMaterial;
      spoolCore: THREE.MeshStandardMaterial;
      orangeThread: THREE.MeshStandardMaterial;
      blueThread: THREE.MeshStandardMaterial;
      ivoryThread: THREE.MeshStandardMaterial;
      tape: THREE.MeshStandardMaterial;
      pearlHead: THREE.MeshStandardMaterial;
      orangeHead: THREE.MeshStandardMaterial;
      particles: THREE.PointsMaterial;
    } = {
      steel: new THREE.MeshStandardMaterial({
        color: 0xcfd9e5,
        metalness: 0.95,
        roughness: 0.2,
      }),
      needle: new THREE.MeshStandardMaterial({
        color: 0xe6eef8,
        metalness: 0.98,
        roughness: 0.12,
      }),
      spoolWood: new THREE.MeshStandardMaterial({
        color: 0x5a4128,
        roughness: 0.75,
        metalness: 0.05,
      }),
      spoolCore: new THREE.MeshStandardMaterial({
        color: 0x221a14,
        roughness: 0.9,
      }),
      orangeThread: new THREE.MeshStandardMaterial({
        color: 0xdf5821,
        roughness: 0.45,
        metalness: 0.1,
        emissive: 0x2b0d02,
      }),
      blueThread: new THREE.MeshStandardMaterial({
        color: 0x6ea3e8,
        roughness: 0.5,
        metalness: 0.1,
        emissive: 0x07152d,
      }),
      ivoryThread: new THREE.MeshStandardMaterial({
        color: 0xf1f5fb,
        roughness: 0.6,
        metalness: 0.05,
      }),
      tape: new THREE.MeshStandardMaterial({
        roughness: 0.55,
        metalness: 0.05,
        side: THREE.DoubleSide,
      }),
      pearlHead: new THREE.MeshStandardMaterial({
        color: 0xf8fafc,
        roughness: 0.18,
        metalness: 0.35,
      }),
      orangeHead: new THREE.MeshStandardMaterial({
        color: 0xdf5821,
        roughness: 0.25,
        metalness: 0.3,
      }),
      particles: new THREE.PointsMaterial({
        color: 0xa8c8f0,
        size: 0.045,
        transparent: true,
        opacity: 0.45,
      }),
    };

    function updateThemeColors() {
      const light = isLightMode();
      if (light) {
        materials.orangeThread.color.setHex(0xb13d0b);
        materials.orangeThread.emissive.setHex(0x000000);
        materials.blueThread.color.setHex(0x2f64b0);
        materials.blueThread.emissive.setHex(0x000000);
        materials.spoolWood.color.setHex(0x6e5239);
        materials.particles.color.setHex(0x5c7090);
        materials.particles.opacity = 0.35;
        ambientLight.intensity = 1.35;
        ambientLight.color.setHex(0xf4f7fb);
        keyLight.intensity = 2.0;
        fillLight.intensity = 1.2;
      } else {
        materials.orangeThread.color.setHex(0xdf5821);
        materials.orangeThread.emissive.setHex(0x351004);
        materials.blueThread.color.setHex(0x6ea3e8);
        materials.blueThread.emissive.setHex(0x0b1e3d);
        materials.spoolWood.color.setHex(0x4a3420);
        materials.particles.color.setHex(0xa8c8f0);
        materials.particles.opacity = 0.55;
        ambientLight.intensity = 0.95;
        ambientLight.color.setHex(0x132b52);
        keyLight.intensity = 2.5;
        fillLight.intensity = 1.6;
      }
    }

    // Lights
    const ambientLight = new THREE.AmbientLight(0x132b52, 0.95);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xfff7ed, 2.5);
    keyLight.position.set(5, 7, 6);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0x8da3c6, 1.6);
    fillLight.position.set(-6, -4, 4);
    scene.add(fillLight);

    // Warm thread rim light
    const threadLight = new THREE.PointLight(0xdf5821, 1.8, 10);
    threadLight.position.set(2, 1, 2);
    scene.add(threadLight);

    // ==========================================
    // 1. Procedural Sewing Needle (Jarum Jahit)
    // ==========================================
    const needleGroup = new THREE.Group();

    // Shaft (sleek tapered body)
    const needleShaftGeo = new THREE.CylinderGeometry(0.045, 0.032, 3.4, 16);
    const needleShaft = new THREE.Mesh(needleShaftGeo, materials.needle);
    needleGroup.add(needleShaft);

    // Tapered tip
    const needleTipGeo = new THREE.ConeGeometry(0.032, 0.8, 16);
    needleTipGeo.translate(0, -1.7 - 0.4, 0);
    const needleTip = new THREE.Mesh(needleTipGeo, materials.needle);
    needleGroup.add(needleTip);

    // Needle eye section (flattened oval head)
    const eyeHeadGeo = new THREE.CylinderGeometry(0.065, 0.045, 0.7, 16);
    eyeHeadGeo.translate(0, 1.7 + 0.35, 0);
    const eyeHead = new THREE.Mesh(eyeHeadGeo, materials.needle);
    eyeHead.scale.set(1.35, 1.0, 0.4);
    needleGroup.add(eyeHead);

    // The eyelet loop (hole where thread passes)
    const eyeHoleGeo = new THREE.TorusGeometry(0.07, 0.022, 12, 24);
    eyeHoleGeo.scale(0.45, 2.0, 1.0);
    eyeHoleGeo.translate(0, 1.7 + 0.45, 0);
    const eyeHole = new THREE.Mesh(eyeHoleGeo, materials.needle);
    needleGroup.add(eyeHole);

    // Position needle gracefully floating in the upper right periphery
    needleGroup.position.set(3.8, 1.4, -0.2);
    needleGroup.rotation.set(0.4, -0.35, -0.72);
    needleGroup.scale.set(0.7, 0.7, 0.7);
    scene.add(needleGroup);

    // ==========================================
    // 2. Continuous 3D Threads (Benang Konveksi)
    // ==========================================
    // Primary Signature Thread (Rust Orange) passing directly through needle eye!
    // World point of needle eye:
    const needleEyeWorld = new THREE.Vector3(0, 1.7 + 0.45, 0);
    needleGroup.localToWorld(needleEyeWorld.clone());

    const orangePoints = [
      new THREE.Vector3(-6.8, -2.6, -1.8),
      new THREE.Vector3(-4.8, -1.4, -1.0),
      new THREE.Vector3(-2.2, -0.2, -0.1),
      new THREE.Vector3(-0.2, 0.5, 0.4),
      new THREE.Vector3(1.6, 0.2, 0.2),
      new THREE.Vector3(3.0, 0.8, 0.1),
      // Passes directly through the needle eyelet
      new THREE.Vector3(3.62, 1.25, -0.18),
      new THREE.Vector3(3.88, 1.62, -0.28),
      // Graceful trail looping behind
      new THREE.Vector3(4.5, 2.0, -0.8),
      new THREE.Vector3(5.6, 1.6, -1.8),
      new THREE.Vector3(6.8, 2.4, -3.0),
    ];
    const orangeCurve = new THREE.CatmullRomCurve3(orangePoints, false, 'centripetal', 0.5);
    const orangeThreadGeo = new THREE.TubeGeometry(orangeCurve, 90, 0.02, 8, false);
    const orangeThreadMesh = new THREE.Mesh(orangeThreadGeo, materials.orangeThread);
    scene.add(orangeThreadMesh);

    // Secondary Blueprint Blue Thread
    const bluePoints = [
      new THREE.Vector3(-6.8, 2.4, -2.4),
      new THREE.Vector3(-4.2, 1.8, -1.4),
      new THREE.Vector3(-1.5, 2.2, -0.8),
      new THREE.Vector3(1.2, 1.2, -1.0),
      new THREE.Vector3(3.2, -0.4, -0.6),
      new THREE.Vector3(4.8, -1.4, -1.6),
      new THREE.Vector3(6.8, -2.2, -2.8),
    ];
    const blueCurve = new THREE.CatmullRomCurve3(bluePoints, false, 'catmullrom', 0.4);
    const blueThreadGeo = new THREE.TubeGeometry(blueCurve, 70, 0.016, 8, false);
    const blueThreadMesh = new THREE.Mesh(blueThreadGeo, materials.blueThread);
    scene.add(blueThreadMesh);

    // Tertiary Ivory Filament in deep background
    const ivoryPoints = [
      new THREE.Vector3(-5.0, 0.2, -3.5),
      new THREE.Vector3(-2.5, -2.2, -2.8),
      new THREE.Vector3(0.5, -1.6, -3.2),
      new THREE.Vector3(3.5, 0.2, -3.0),
      new THREE.Vector3(5.5, -1.0, -4.0),
    ];
    const ivoryCurve = new THREE.CatmullRomCurve3(ivoryPoints, false, 'catmullrom');
    const ivoryThreadGeo = new THREE.TubeGeometry(ivoryCurve, 50, 0.016, 6, false);
    const ivoryThreadMesh = new THREE.Mesh(ivoryThreadGeo, materials.ivoryThread);
    scene.add(ivoryThreadMesh);

    // ==========================================
    // 3. Thread Spools (Gelendong Benang)
    // ==========================================
    function createSpool(threadMat: THREE.MeshStandardMaterial) {
      const spool = new THREE.Group();

      // Top & bottom flanges
      const flangeGeo = new THREE.CylinderGeometry(0.44, 0.44, 0.09, 20);
      const topFlange = new THREE.Mesh(flangeGeo, materials.spoolWood);
      topFlange.position.y = 0.55;
      const btmFlange = new THREE.Mesh(flangeGeo, materials.spoolWood);
      btmFlange.position.y = -0.55;

      // Spindle core hole
      const coreGeo = new THREE.CylinderGeometry(0.12, 0.12, 1.25, 14);
      const core = new THREE.Mesh(coreGeo, materials.spoolCore);

      // Wound thread cylinder
      const threadGeo = new THREE.CylinderGeometry(0.38, 0.38, 0.98, 20);
      const thread = new THREE.Mesh(threadGeo, threadMat);

      // Fine thread ridge rings for texture
      for (let i = -3; i <= 3; i++) {
        const ringGeo = new THREE.TorusGeometry(0.385, 0.012, 6, 20);
        ringGeo.rotateX(Math.PI / 2);
        const ring = new THREE.Mesh(ringGeo, threadMat);
        ring.position.y = i * 0.13;
        spool.add(ring);
      }

      spool.add(topFlange, btmFlange, core, thread);
      return spool;
    }

    // Spool 1: Rust Orange (left periphery, lower)
    const spool1 = createSpool(materials.orangeThread);
    spool1.position.set(-4.6, -1.4, -1.6);
    spool1.rotation.set(0.6, 0.8, -0.4);
    spool1.scale.set(0.78, 0.78, 0.78);
    scene.add(spool1);

    // Spool 2: Blueprint Blue (right periphery, deep)
    const spool2 = createSpool(materials.blueThread);
    spool2.position.set(4.8, -1.8, -2.8);
    spool2.rotation.set(-0.5, -0.6, 0.7);
    spool2.scale.set(0.68, 0.68, 0.68);
    scene.add(spool2);

    // ==========================================
    // 4. Tailor's Measuring Tape (Meteran Jahit)
    // ==========================================
    // Procedural tape canvas texture with mm ticks
    const tapeCanvas = document.createElement('canvas');
    tapeCanvas.width = 512;
    tapeCanvas.height = 32;
    const tctx = tapeCanvas.getContext('2d');
    if (tctx) {
      tctx.fillStyle = '#f3df8a'; // Tailor's vintage measuring yellow
      tctx.fillRect(0, 0, 512, 32);
      // Red edge stripe
      tctx.fillStyle = '#c54917';
      tctx.fillRect(0, 0, 512, 2);
      tctx.fillRect(0, 30, 512, 2);

      // Tick marks
      tctx.fillStyle = '#1c2838';
      for (let x = 0; x < 512; x += 6) {
        const isMajor = x % 48 === 0;
        const isMed = x % 24 === 0;
        const h = isMajor ? 18 : isMed ? 12 : 7;
        tctx.fillRect(x, 2, 1.2, h);
        if (isMajor) {
          tctx.font = 'bold 8px monospace';
          tctx.fillText(String(x / 6), x + 2, 26);
        }
      }
    }
    const tapeTexture = new THREE.CanvasTexture(tapeCanvas);
    tapeTexture.wrapS = THREE.RepeatWrapping;
    tapeTexture.repeat.set(5, 1);
    materials.tape.map = tapeTexture;

    // Spiral curve for measuring tape
    const tapePoints: THREE.Vector3[] = [];
    const tapeTurns = 2.4;
    const tapeSegments = 70;
    for (let i = 0; i <= tapeSegments; i++) {
      const t = i / tapeSegments;
      const angle = t * Math.PI * 2 * tapeTurns;
      const radius = 0.55 + t * 0.9;
      const x = Math.cos(angle) * radius;
      const y = (t - 0.5) * 1.8;
      const z = Math.sin(angle) * radius * 0.6;
      tapePoints.push(new THREE.Vector3(x, y, z));
    }
    const tapeCurve = new THREE.CatmullRomCurve3(tapePoints);
    const tapeGeo = new THREE.TubeGeometry(tapeCurve, 60, 0.08, 4, false);
    tapeGeo.scale(1, 0.15, 1); // Flatten into a ribbon strip
    const tapeMesh = new THREE.Mesh(tapeGeo, materials.tape);
    tapeMesh.position.set(-4.2, 1.8, -2.4);
    tapeMesh.rotation.set(0.4, 0.6, -0.3);
    tapeMesh.scale.set(0.72, 0.72, 0.72);
    scene.add(tapeMesh);

    // ==========================================
    // 5. Tailor's Shears / Scissors (Gunting Konveksi)
    // ==========================================
    const scissors = new THREE.Group();

    // Pivot screw
    const pivotScrew = new THREE.Mesh(
      new THREE.CylinderGeometry(0.065, 0.065, 0.08, 14),
      materials.steel,
    );
    pivotScrew.rotation.x = Math.PI / 2;
    scissors.add(pivotScrew);

    // Blade 1
    const bladeGeo = new THREE.BoxGeometry(0.075, 1.6, 0.024);
    bladeGeo.translate(0, 0.8, 0);
    const blade1 = new THREE.Mesh(bladeGeo, materials.steel);
    blade1.rotation.z = -0.12;

    // Handle loop 1 (upper round loop)
    const handleLoop1 = new THREE.Mesh(
      new THREE.TorusGeometry(0.2, 0.045, 10, 20),
      materials.spoolCore,
    );
    handleLoop1.position.set(0.1, -0.45, 0);
    handleLoop1.rotation.z = -0.25;

    // Blade 2
    const blade2 = new THREE.Mesh(bladeGeo, materials.steel);
    blade2.rotation.z = 0.18;

    // Handle loop 2 (tailor's elongated bottom loop for multiple fingers)
    const handleLoop2 = new THREE.Mesh(
      new THREE.TorusGeometry(0.26, 0.045, 10, 20),
      materials.spoolCore,
    );
    handleLoop2.scale.set(1.4, 0.9, 1);
    handleLoop2.position.set(-0.16, -0.52, 0);
    handleLoop2.rotation.z = 0.3;

    scissors.add(blade1, handleLoop1, blade2, handleLoop2);
    scissors.position.set(4.5, -0.2, -2.2);
    scissors.rotation.set(-0.35, -0.5, 0.6);
    scissors.scale.set(0.65, 0.65, 0.65);
    scene.add(scissors);

    // ==========================================
    // 6. Pearl-Head Pins (Jarum Pentul)
    // ==========================================
    function createPin(headMat: THREE.MeshStandardMaterial) {
      const pin = new THREE.Group();
      const shaft = new THREE.Mesh(
        new THREE.CylinderGeometry(0.016, 0.006, 1.3, 10),
        materials.steel,
      );
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.09, 14, 14), headMat);
      head.position.y = 0.65;
      pin.add(shaft, head);
      return pin;
    }

    const pin1 = createPin(materials.pearlHead);
    pin1.position.set(-2.8, -2.4, -0.4);
    pin1.rotation.set(0.5, 0.3, 0.4);
    pin1.scale.set(0.8, 0.8, 0.8);
    scene.add(pin1);

    const pin2 = createPin(materials.orangeHead);
    pin2.position.set(-2.2, -2.6, -0.8);
    pin2.rotation.set(0.2, -0.4, 0.8);
    pin2.scale.set(0.8, 0.8, 0.8);
    scene.add(pin2);

    const pin3 = createPin(materials.pearlHead);
    pin3.position.set(2.6, -2.6, -0.2);
    pin3.rotation.set(-0.6, 0.5, -0.5);
    pin3.scale.set(0.8, 0.8, 0.8);
    scene.add(pin3);

    // ==========================================
    // 7. Ambient Textile Motes / Fiber Particles
    // ==========================================
    const particleCount = 70;
    const particlePositions = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount * 3; i += 3) {
      particlePositions[i] = (Math.random() - 0.5) * 14;
      particlePositions[i + 1] = (Math.random() - 0.5) * 8;
      particlePositions[i + 2] = (Math.random() - 0.5) * 6 - 1.5;
    }
    const particleGeo = new THREE.BufferGeometry();
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    const particleSystem = new THREE.Points(particleGeo, materials.particles);
    scene.add(particleSystem);

    // Initial theme color setup
    updateThemeColors();

    // ==========================================
    // Lifecycle, Performance & Parallax Handlers
    // ==========================================

    // Pointer parallax (damped, very subtle)
    function onPointerMove(e: MouseEvent) {
      targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    }
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    // Resize handler
    function onResize() {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer?.setSize(width, height, false);
      if (prefersReducedMotion) {
        renderer?.render(scene, camera);
      }
    }
    window.addEventListener('resize', onResize, { passive: true });

    // Watch theme changes (via data-theme attribute on <html>)
    const themeObserver = new MutationObserver(() => {
      updateThemeColors();
      if (prefersReducedMotion) {
        renderer?.render(scene, camera);
      }
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // Page Visibility (pause loop when tab inactive)
    function onVisibilityChange() {
      isTabActive = !document.hidden;
      if (isTabActive && isVisible && !animId && !prefersReducedMotion) {
        startTime = performance.now();
        tick();
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange);

    // IntersectionObserver (pause loop when out of viewport)
    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible && isTabActive && !animId && !prefersReducedMotion) {
          startTime = performance.now();
          tick();
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(container);

    // Reduced motion listener
    reducedMotionQuery.addEventListener('change', (e) => {
      prefersReducedMotion = e.matches;
      if (prefersReducedMotion && animId) {
        cancelAnimationFrame(animId);
        animId = null;
        renderer?.render(scene, camera);
      } else if (!prefersReducedMotion && !animId && isVisible && isTabActive) {
        tick();
      }
    });

    // ==========================================
    // Render Loop (60 FPS, silky smooth & light)
    // ==========================================
    function tick() {
      if (!isVisible || !isTabActive || prefersReducedMotion) {
        animId = null;
        return;
      }

      const elapsed = (performance.now() - startTime) * 0.001;

      // Smooth mouse parallax interpolation
      currentMouseX += (targetMouseX - currentMouseX) * 0.04;
      currentMouseY += (targetMouseY - currentMouseY) * 0.04;

      // Camera parallax
      camera.position.x = currentMouseX * 0.45;
      camera.position.y = -currentMouseY * 0.35;
      camera.lookAt(0, 0, 0);

      // Needle: gentle breathing hover & tilt
      needleGroup.position.y = 0.9 + Math.sin(elapsed * 1.2) * 0.08;
      needleGroup.rotation.z = -0.65 + Math.cos(elapsed * 0.9) * 0.04;
      needleGroup.rotation.y = -0.4 + Math.sin(elapsed * 0.7) * 0.05;

      // Threads: organic undulating wave motion
      orangeThreadMesh.rotation.z = Math.sin(elapsed * 0.45) * 0.03;
      orangeThreadMesh.position.y = Math.sin(elapsed * 0.8) * 0.06;

      blueThreadMesh.rotation.z = -Math.cos(elapsed * 0.35) * 0.03;
      blueThreadMesh.position.y = Math.cos(elapsed * 0.7) * 0.05;

      ivoryThreadMesh.position.y = Math.sin(elapsed * 0.5) * 0.04;

      // Spool 1: slow floating tumble
      spool1.rotation.y = elapsed * 0.22;
      spool1.rotation.x = 0.6 + Math.sin(elapsed * 0.5) * 0.06;
      spool1.position.y = -1.4 + Math.cos(elapsed * 0.8) * 0.08;

      // Spool 2: deep ambient drift
      spool2.rotation.y = -elapsed * 0.16;
      spool2.position.y = -1.8 + Math.sin(elapsed * 0.6) * 0.06;

      // Measuring tape: subtle swaying spiral
      tapeMesh.rotation.y = 0.6 + Math.sin(elapsed * 0.4) * 0.12;
      tapeMesh.position.y = 1.5 + Math.cos(elapsed * 0.6) * 0.07;

      // Scissors: slow majestic drift in upper right
      scissors.rotation.y = -0.5 + Math.sin(elapsed * 0.5) * 0.05;
      scissors.position.y = 2.2 + Math.cos(elapsed * 0.7) * 0.06;

      // Pearl pins: gentle micro-hover
      pin1.position.y = -2.2 + Math.sin(elapsed * 1.1) * 0.04;
      pin2.position.y = -2.5 + Math.cos(elapsed * 0.9) * 0.04;
      pin3.position.y = -2.6 + Math.sin(elapsed * 1.3) * 0.04;

      // Ambient textile particles: slow drift upwards
      const positions = particleGeo.attributes.position.array as Float32Array;
      for (let i = 1; i < particlePositions.length; i += 3) {
        positions[i] += 0.0015;
        if (positions[i] > 4.5) {
          positions[i] = -4.5;
        }
      }
      particleGeo.attributes.position.needsUpdate = true;

      // Render frame
      renderer?.render(scene, camera);

      animId = requestAnimationFrame(tick);
    }

    if (prefersReducedMotion) {
      renderer.render(scene, camera);
    } else {
      tick();
    }

    // Cleanup on window unload / navigation
    window.addEventListener(
      'beforeunload',
      () => {
        if (animId) cancelAnimationFrame(animId);
        observer.disconnect();
        themeObserver.disconnect();
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('resize', onResize);
        document.removeEventListener('visibilitychange', onVisibilityChange);
        renderer?.dispose();
        tapeTexture.dispose();
      },
      { once: true },
    );
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAtelier3D, { once: true });
  } else {
    initAtelier3D();
  }
</script>
