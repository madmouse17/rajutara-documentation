---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/logo/rajutara-128.png';
import { navFor } from '../lib/nav';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nav = navFor(lang);
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-300 px-5 py-14">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3">
          <Image src={logo} alt="" width={64} height={64} class="size-10" />
          <p class="text-xl font-semibold tracking-tight" translate="no">
            Rajutara
          </p>
        </div>
        <p class="mt-4 max-w-[32ch] text-muted">{t(lang, 'footer.tagline')}</p>
      </div>

      <nav
        aria-label={t(lang, 'nav.footer')}
        class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 lg:col-span-8"
      >
        {nav.map((group) => (
          <section>
            <h2 class="text-sm font-semibold">{group.label}</h2>
            <ul class="mt-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    rel={item.external ? 'noopener' : undefined}
                    class="inline-flex h-11 items-center gap-1 text-muted hover:text-fg"
                  >
                    {item.label}
                    {item.external && (
                      <Icon name="ph:arrow-up-right" class="size-4" aria-hidden="true" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <p class="mt-12 max-w-[72ch] text-sm text-faint">{t(lang, 'footer.disclaimer')}</p>
  </div>
</footer>
