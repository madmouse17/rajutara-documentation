---
import { Image } from 'astro:assets';
import logo from '../assets/logo/optirust-128.png';
import { REPO, withBase } from '../lib/site';

const links = [
  { href: withBase('/docs/'), label: 'Docs' },
  { href: withBase('/gallery/'), label: 'Gallery' },
  { href: withBase('/#download'), label: 'Download' },
  { href: withBase('/docs/roadmap/'), label: 'Roadmap' },
  { href: withBase('/docs/contributing/'), label: 'Contributing' },
  { href: `${REPO}/blob/main/CHANGELOG.md`, label: 'Changelog' },
  { href: `${REPO}/security/policy`, label: 'Security' },
  { href: REPO, label: 'Source' },
];
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-300 px-5 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={64} height={64} class="size-10" />
        <div>
          <p class="text-lg font-semibold tracking-tight" translate="no">optirust</p>
          <p class="text-sm text-muted">Licensed under MIT or Apache-2.0, at your option.</p>
        </div>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="inline-flex h-11 items-center text-muted hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="mt-8 max-w-prose text-sm text-faint">
      optirust is independent of Optitex and is not affiliated with, endorsed by or sponsored by its
      owner. Optitex is a trademark of its owner. optirust uses none of its files or formats.
    </p>
  </div>
</footer>
